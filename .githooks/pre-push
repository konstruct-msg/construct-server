#!/bin/sh
#
# Не отдавать в CI то, что CI отвергнет на первом шаге.
#
# 2026-08-13 три деплоя подряд упали на `cargo fmt --all -- --check` из-за одной
# строки, которая не влезла в ширину. Локально всё собиралось: `cargo check` не
# смотрит на форматирование. В CI Format Check стоит первым, поэтому падали не
# только он — не доходило до сборки образа и деплоя, и правки, считавшиеся
# выложенными, три раза оставались только в репозитории.
#
# Порядок здесь тот же, что в .github/workflows/ci.yml, и это намеренно: хук
# ценен ровно настолько, насколько он повторяет то, что решает судьбу пуша.
#
# Включается:   git config core.hooksPath .githooks
# (hooksPath — локальная настройка, свежий клон требует этой строки снова.)
#
# Аварийный выход:   git push --no-verify
# Для случая «CI сейчас не важен», а не для того, чтобы заглушить настоящую находку.

set -e
cd "$(git rev-parse --show-toplevel)"

fail=0

# CI начинает с `cargo audit --deny warnings` (Security Audit) и роняет на нём всё
# остальное, деплой тоже. 2026-10-14 так упал пуш: rustls 0.23.45 получил четыре
# RUSTSEC в день пуша, а локально этого никто не проверял. База уязвимостей
# обновляется независимо от кода — свежую находку ловит только запуск перед пушем.
printf '\n[pre-push] cargo audit --deny warnings\n'
if ! command -v cargo-audit >/dev/null 2>&1; then
    fail=1
    printf '\n  cargo-audit не установлен: cargo install cargo-audit --locked\n'
elif ! audit_out=$(cargo audit --deny warnings 2>&1); then
    if printf '%s' "$audit_out" | grep -q 'RUSTSEC-'; then
        printf '%s\n' "$audit_out"
        fail=1
        printf '\n  обычно чинится: cargo update -p <крейт> --precise <версия из Solution>\n'
    else
        # Не находка, а сеть: база не скачалась. Проверить по уже скачанной —
        # лучше старая база, чем никакой; пуш без сети не запрещается.
        printf '  база уязвимостей не обновилась — проверка по локальной копии\n'
        cargo audit --deny warnings --no-fetch || fail=1
    fi
fi

printf '\n[pre-push] cargo fmt\n'
if ! cargo fmt --all -- --check; then
    fail=1
    printf '\n  чинится одной командой: cargo fmt --all\n'
fi

printf '\n[pre-push] наблюдаемость подключена к чему-то настоящему\n'
python3 scripts/check-observability.py || fail=1

# Clippy идёт последним и только если предыдущее прошло: он самый долгий
# (минуты на холодном target), и ждать его ради ошибки форматирования незачем.
# Пропускается через SKIP_CLIPPY=1, когда правка заведомо не касается Rust —
# но по умолчанию он есть, потому что `-D warnings` в CI роняет ровно так же,
# как fmt, и с тем же результатом: деплой не состоялся.
if [ "$fail" -eq 0 ] && [ "${SKIP_CLIPPY:-0}" != "1" ]; then
    printf '\n[pre-push] clippy -D warnings (SKIP_CLIPPY=1 чтобы пропустить)\n'
    cargo clippy --all-targets --all-features -- -D warnings || fail=1
fi

# Репозиторий публичный, а утечку координат фронта CI не поймает: она проходит
# все проверки как обычный JSON. И откатить её нельзя — после пуша содержимое
# остаётся доступным по SHA даже после переписывания истории. Поэтому здесь.
printf '\n[pre-push] таймауты Redis\n'
scripts/check-redis-timeouts.sh || fail=1

printf '\n[pre-push] координаты veil-front\n'
"$(git rev-parse --show-toplevel)/.githooks/no-front-coordinates" || fail=1

if [ "$fail" -ne 0 ]; then
    cat <<'EOF'

[pre-push] ОСТАНОВЛЕНО — CI отверг бы это на первом же шаге, а вместе с ним
и деплой. Именно так 777fb01, 87b3888 и 7dc6723 три раза выглядели выложенными,
не будучи выложенными.

EOF
    exit 1
fi

printf '\n[pre-push] ок\n\n'
