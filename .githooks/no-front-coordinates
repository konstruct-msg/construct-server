#!/bin/sh
#
# Не отдать в публичный репозиторий координаты живого veil-front.
#
# 2026-09-07: во исполнение ops/VEIL_MULTI_FRONT.md §2f-C в подписанный манифест
# добавили оба фронта с их SPKI и запушили в два публичных зеркала. Это ровно та
# «дешёвая энумерация», против которой строится multi-front: цензор получает весь
# список точек входа одним GET. Пришлось чистить манифест, переписывать историю и
# ротировать хостнейм. Инструкция при этом была выполнена буквально — значит
# защищать должен не текст, а проверка.
#
# Проверка НЕ содержит списка живых хостов: сам такой список был бы утечкой.
# Она ищет структуру — поле spki рядом с 64-hex, непустой veil.relays, заполненный
# VEIL_RELAYS, — то есть форму, которую координаты принимают, а не их значения.
#
# Аварийный выход:   git push --no-verify
# Для случая «я точно знаю, что это плейсхолдер», а не чтобы заглушить находку.

set -e
cd "$(git rev-parse --show-toplevel)"

fail=0
note() { printf '  %s\n' "$1"; }

# ── 1. Опубликованный манифест не должен перечислять фронты ──────────────────
for m in .well-known/construct-server tools/.well-known/construct-server; do
    [ -f "$m" ] || continue
    if python3 - "$m" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)                      # битый JSON — не наша забота
v = d.get("veil") or {}
sys.exit(1 if (v.get("relays") or v.get("primary")) else 0)
PY
    then :; else
        fail=1
        printf '\n[no-front-coordinates] %s перечисляет фронты\n' "$m"
        note 'veil.relays / veil.primary в публикуемом манифесте = список точек входа.'
        note 'Оставьте в секции veil только deprecated_ids.'
    fi
done

# ── 2. Ни в одном файле не должно быть spki рядом с 64-hex ───────────────────
hits=$(git grep -nIE '"?spki(_sha256)?"?\s*[:=]\s*"?[0-9a-f]{64}' -- . ':!*.lock' 2>/dev/null || true)
if [ -n "$hits" ]; then
    fail=1
    printf '\n[no-front-coordinates] SPKI-пин в дереве\n'
    printf '%s\n' "$hits" | head -10 | sed 's/^/    /'
    note 'Пин однозначно опознаёт коробку. Держите его в приватном ops.'
fi

# ── 3. VEIL_RELAYS должен быть только примером ───────────────────────────────
# Реальная запись — это addr,scope,spki,sni с 64-hex в третьем поле.
hits=$(git grep -nIE '^[^#]*VEIL_RELAYS=.*,[0-9a-f]{64},' -- . 2>/dev/null || true)
if [ -n "$hits" ]; then
    fail=1
    printf '\n[no-front-coordinates] заполненный VEIL_RELAYS\n'
    printf '%s\n' "$hits" | head -5 | sed 's/^/    /'
    note 'Значение живёт в app.env на home, в репозитории — только <64hex-spki>.'
fi

if [ "$fail" -ne 0 ]; then
    printf '\nПодробности: construct-docs decisions/veil-front-coordinates-are-not-public.md\n'
    exit 1
fi

printf '[no-front-coordinates] ok\n'
