BUNDLE_SIGNING_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
BUNDLE_SIGNING_PUBLIC_KEY=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC=
CSRF_SECRET=fixture-csrf-secret-32-characters-min
MEDIA_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MEDIA_UPLOAD_TOKEN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOG_HASH_SALT=fixture-log-hash-salt-not-for-prod-use
USERNAME_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CONTACT_HMAC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
REQUEST_ENVELOPE_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
TURN_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
