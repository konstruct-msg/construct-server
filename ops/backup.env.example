# Скопировать в ops/backup.env на сервере, chmod 600. В git не попадает.
#
# Приватный age-ключ здесь НЕ указывается и на сервере не хранится: иначе
# потеря машины уносит данные и ключ разом. Здесь только публичный.
BACKUP_AGE_RECIPIENT=age1...

# Hetzner Storage Box. Порт 23, не 22 — у них SSH на нестандартном.
BACKUP_SSH_HOST=uXXXXXX.your-storagebox.de
BACKUP_SSH_USER=uXXXXXX
BACKUP_SSH_PORT=23
BACKUP_REMOTE_DIR=construct

BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Только для ops/restore-test.sh на машине оператора. На сервере не задавать —
# приватный ключ там лежать не должен.
# Имя файла именно такое: doc и реальный ключ используют construct-backup.key,
# а здесь до 2026-08-15 стояло construct.key. Расхождение стоило бы времени
# ровно тогда, когда его нет — при восстановлении.
# BACKUP_AGE_IDENTITY=~/.config/age/construct-backup.key
