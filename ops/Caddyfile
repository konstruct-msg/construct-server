{
	grace_period 10s
	admin 127.0.0.1:2019
	# Per-request metrics. Caddy is the only process that sees API requests: the
	# gateway proxied them once and no longer does (its router is /health,
	# /metrics and /.well-known), so `gateway_requests_total` in construct-metrics
	# had no producer and could only ever have measured health checks. Removed
	# there, collected here instead.
	#
	# Global option, not the nested `servers { metrics }` — that spelling is
	# deprecated and `caddy validate` says so.
	metrics

	servers {
		# TCP-only: UDP 443 on the host belongs to construct-transport
		# (SALAMANDER obfuscated QUIC, rcgen self-signed cert). Without this,
		# Caddy advertises `alt-svc: h3=":443"` and iOS URLSession follows it
		# onto SALAMANDER → TLS -1200 on every URLSession fetch (e.g.
		# ServerKeyManager's well-known fetch for the stealth token key).
		protocols h1 h2
	}
}

# Prometheus scrape target, reachable only from the compose `internal` network —
# no host port is published for it.
#
# Deliberately NOT the admin API (`admin 127.0.0.1:2019` above stays on
# loopback): that endpoint can reconfigure or stop Caddy, and exposing it to
# every container so a scraper can read counters trades the TLS terminator for a
# graph. This block serves the same registry and nothing else.
:2020 {
	metrics /metrics
}

ams.konstruct.cc {
	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-Grpc-Web, X-User-Agent, X-CSRF-Token, Grpc-Timeout"
		Access-Control-Expose-Headers "Grpc-Status, Grpc-Message, Grpc-Encoding, Grpc-Accept-Encoding"
		Access-Control-Allow-Origin *
		Vary Origin
	}

	handle /.well-known* {
		reverse_proxy gateway:3000
	}
	handle /health {
		reverse_proxy gateway:3000
	}
	handle /shared.proto.services.v1.AuthService/* {
		reverse_proxy h2c://identity:50051
	}
	handle /shared.proto.services.v1.DeviceService/* {
		reverse_proxy h2c://identity:50051
	}
	handle /shared.proto.services.v1.DeviceLinkService/* {
		reverse_proxy h2c://identity:50051
	}
	handle /shared.proto.services.v1.UserService/* {
		reverse_proxy h2c://identity:50051
	}
	handle /shared.proto.services.v1.InviteService/* {
		reverse_proxy h2c://identity:50051
	}
	handle /shared.proto.services.v1.MessagingService/* {
		reverse_proxy h2c://messaging:50053 {
			flush_interval -1
		}
	}
	handle /construct.message_gateway.v1.MessageGateway/* {
		reverse_proxy h2c://messaging:50053
	}
	handle /shared.proto.services.v1.NotificationService/* {
		reverse_proxy h2c://messaging:50053
	}
	handle /shared.proto.services.v1.VeilService/* {
		reverse_proxy h2c://veil:50056
	}
	handle /shared.proto.services.v1.KeyService/* {
		reverse_proxy h2c://key:50057
	}
	handle /shared.proto.services.v1.MediaService/* {
		reverse_proxy h2c://media:50056
	}
	handle /shared.proto.services.v1.MlsService/* {
		reverse_proxy h2c://group:50058
	}
	handle /shared.proto.services.v1.ChannelService/* {
		reverse_proxy h2c://group:50058
	}
	handle /shared.proto.sentinel.v1.SentinelService/* {
		reverse_proxy h2c://messaging:50053
	}
	handle /shared.proto.signaling.v1.SignalingService/* {
		reverse_proxy h2c://signaling:50060 {
			flush_interval -1
		}
	}

	handle /federation/v1/* {
		reverse_proxy h2c://messaging:8083
	}

	handle {
		respond "not found" 404
	}
}

